#!/usr/bin/env bash
#

# Load libs
source "$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"/lib.sh

# Exit immediately if anything exits with a non-zero status.
set -e

COMMAND_NAME=$1


sub_help () {
    echo "Usage: $(basename $0) <command>"
    echo "Commands:"
    echo "   help                   This help message"
    echo "   bootstrap              Bootstrap the dotfiles"
    echo "   sshconfig              Setup ssh config file"
    echo "   gitconfig              Setup git configuration & SSH commit signing"
    echo "   gitconfig --local      Setup commit signing (email, SSH key) for the current repo only"
    echo "   install macos          Install reasonable macOS defaults"
    echo "   install macos <app>    Apply prefs for just one app/pane (e.g. finder, dock)"
    echo "   install homebrew       Install homebrew & cask"
    echo "   install homebrew <x>   Install one Brewfile entry + its prefs (e.g. sublime-text)"
    echo "   install ai             Install AI tooling (sbx, Claude desktop) & agent skills"
    echo "   install <x>            Install package x"
}



# Helper functions

link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        action=
        until [ -n "$action" ]
        do
          warn "$dst already exists, what do you want to do? [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
          # Read from the controlling terminal explicitly, not stdin: callers
          # like sub_bootstrap run this inside a `while read < <(find ...)`
          # loop, which binds fd 0 to the find pipe for the whole loop body.
          # A plain `read` here would silently steal bytes off that pipe
          # instead of waiting for a keypress - resolving prompts on stray
          # characters from upcoming filenames and corrupting the next
          # iteration's $src in the process.
          read -n 1 action < /dev/tty
          echo

          case "$action" in
            o )
              overwrite=true;;
            O )
              overwrite_all=true;;
            b )
              backup=true;;
            B )
              backup_all=true;;
            s )
              skip=true;;
            S )
              skip_all=true;;
            * )
              action=;;
          esac
        done

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      ok "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      ok "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      ok "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    ok "linked $1 to $2"
  fi
}

# Sub commands

sub_bootstrap () {
  bot 'Updating repo & submodules...'
  if [ -d "$DOTFILES_DIR/.git" ]; then
    pushd $DOTFILES_DIR >/dev/null
    git pull origin master
    ok "repository updated"
    git submodule update --init --recursive
    ok "submodules initialized & updated"
    popd >/dev/null
  fi

  bot 'Installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  while IFS= read -r -d '' src
  do
    # Everything below the topic dir (the *.symlink file's path relative to
    # the immediate child-of-$DOTFILES_DIR directory it lives in) is mirrored
    # as-is under $HOME, with the .symlink suffix stripped. E.g.
    # zsh/.zshrc.symlink -> ~/.zshrc, and
    # ghostty/.config/ghostty/config.symlink -> ~/.config/ghostty/config.
    # Nothing adds a leading dot implicitly (unlike the old basename-only
    # rule this replaced) - a top-level dotfile source has to spell it out
    # itself, e.g. zsh/.zshrc.symlink, not zsh/zshrc.symlink.
    rel="${src#"$DOTFILES_DIR"/}"
    rel="${rel#*/}"
    dst="$HOME/${rel%.symlink}"
    mkdir -p "$(dirname "$dst")"
    link_file "$src" "$dst"
  done < <(find "$DOTFILES_DIR" -mindepth 2 -not -path "$DOTFILES_DIR/.git/*" -name '*.symlink' -print0)

  ok 'dotfiles installed'
}

# Asks for an SSH public key and leaves it in $git_signingkey as
# "<type> <base64>" (any trailing comment dropped), or empty when the answer
# was blank. Fails when the answer is not an SSH public key.
read_signingkey () {
  local key_type key_blob
  read -e -r git_signingkey
  read -r key_type key_blob _ <<< "$git_signingkey"

  if [[ -z $git_signingkey ]]
  then
    return 0
  elif [[ $key_type == ssh-* && -n $key_blob ]]
  then
    git_signingkey="$key_type $key_blob"
  else
    error 'That does not look like an SSH public key (expected "ssh-ed25519 AAAA..."), nothing changed.'
    return 1
  fi
}

# Turns on commit signing with an SSH key held in 1Password.
# $1 is the public key, $2 the author email it signs for, the rest says which
# git config to write to (`--file <path>`, `--local`).
set_git_signing () {
  local key=$1 email=$2
  shift 2

  git config "$@" user.signingkey "$key"
  git config "$@" gpg.format ssh
  git config "$@" gpg.ssh.program /Applications/1Password.app/Contents/MacOS/op-ssh-sign
  git config "$@" gpg.ssh.allowedSignersFile '~/.ssh/allowed_signers'
  git config "$@" commit.gpgsign true

  # Lets `git log --show-signature` verify our own commits locally: the file
  # maps an author email to the key(s) allowed to sign for it.
  local signer="$email namespaces=\"git\" $key"
  mkdir -p ~/.ssh
  chmod 700 ~/.ssh
  if ! grep -qxF "$signer" ~/.ssh/allowed_signers 2>/dev/null
  then
    echo "$signer" >> ~/.ssh/allowed_signers
  fi
}

sub_gitconfig () {
  if [ "${1:-}" = "--local" ]
  then
    sub_gitconfig_local
    return
  fi

  local gitconfig="$DOTFILES_DIR/git/.gitconfig.symlink"

  if ! [ -f "$gitconfig" ]
  then
    bot 'Setup gitconfig'

    echo -e ' - What is your global git author name?'
    read -e git_authorname
    echo -e ' - What is your global git author email?'
    read -e git_authoremail

    # Fill the template in with `git config` rather than sed: the values land
    # in the file verbatim, whatever characters they contain.
    cp "$DOTFILES_DIR/git/gitconfig.symlink.example" "$gitconfig"
    git config --file "$gitconfig" user.name "$git_authorname"
    git config --file "$gitconfig" user.email "$git_authoremail"

    ok 'gitconfig set up'
  fi

  # Commits are signed with an SSH key that lives in 1Password. This is asked
  # separately from the block above so it can be answered on a later run: on
  # a fresh machine 1Password isn't installed yet when setup.sh gets here.
  # It also converts a gitconfig generated before the switch from GPG.
  local signingkey
  signingkey="$(git config --file "$gitconfig" user.signingkey || true)"
  if [[ $signingkey != ssh-* ]]
  then
    bot 'Git commit signing'

    echo -e ' - Paste the public SSH key to sign commits with (in 1Password: the "public key" field of the SSH key item). Leave blank to set this up later.'
    read_signingkey

    if [[ -n $git_signingkey ]]
    then
      set_git_signing "$git_signingkey" "$(git config --file "$gitconfig" user.email)" --file "$gitconfig"
      ok 'commit signing set up'
    elif [[ -z $signingkey || $signingkey == AUTHORSIGNINGKEY ]]
    then
      # No key at all: signing has to be off, or every commit fails.
      git config --file "$gitconfig" --unset user.signingkey || true
      git config --file "$gitconfig" commit.gpgsign false
      warn 'No signing key set, commit signing is off. Run `dotfiles gitconfig` again to set one.'
    else
      warn "Keeping the existing signing key ($signingkey). Run \`dotfiles gitconfig\` again to switch to an SSH key."
    fi
  fi
}

# `dotfiles gitconfig --local`: sets up commit signing for the repository in
# the current directory only, for repos that use another author email and/or
# another key than the global gitconfig. Can be re-run to change either.
sub_gitconfig_local () {
  local repo
  if ! repo="$(git rev-parse --show-toplevel 2>/dev/null)"
  then
    error 'Not inside a git repository.'
    return 1
  fi

  bot "Git commit signing for $repo"

  local email signingkey
  email="$(git config user.email || true)"
  signingkey="$(git config user.signingkey || true)"
  [[ $signingkey == ssh-* ]] || signingkey=

  echo -e " - What is the author email for this repository? Leave blank to keep ${email:-<none>}."
  read -e -r git_authoremail
  email="${git_authoremail:-$email}"
  if [[ -z $email ]]
  then
    error 'No author email set, nothing changed.'
    return 1
  fi

  echo -e " - Paste the public SSH key to sign commits with in this repository. Leave blank to keep ${signingkey:-<none>}."
  read_signingkey
  signingkey="${git_signingkey:-$signingkey}"
  if [[ -z $signingkey ]]
  then
    error 'No SSH signing key given and none set globally, signing not changed.'
    return 1
  fi

  # Written only now, so a rejected answer above leaves the repo untouched.
  git config --local user.email "$email"
  set_git_signing "$signingkey" "$email" --local
  ok "commits in this repository are signed as $email"
}

sub_sshconfig () {
  if ! [ -f ~/.ssh/config ]
  then
    bot 'SSH config'
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh
    cp $DOTFILES_DIR/ssh/config.example ~/.ssh/config

    # No key is generated here: private keys live in 1Password and are served
    # by its SSH agent (see IdentityAgent in ssh/config.example), so there is
    # nothing to put on disk.
    warn 'SSH keys come from the 1Password SSH agent: turn it on in 1Password > Settings > Developer once 1Password is installed.'
  fi
}

sub_install () {
    # Not `local topic="$1"; shift`: with no arguments, that `shift` fails and
    # set -e ends the whole script silently.
    local topic="${1:-}"
    if [ -z "$topic" ]; then
        error "Missing topic to install, one of: $(cd "$DOTFILES_DIR" && ls -d */install.sh | sed 's|/install.sh$||' | tr '\n' ' ')"
        return 1
    fi
    shift

    local SCRIPT="${DOTFILES_DIR}/${topic}/install.sh"
    if [ -f "$SCRIPT" ]; then
        source "$SCRIPT" "$@"
    else
        error "Unable to find script to install ${topic}"
        return 1
    fi
}


case $COMMAND_NAME in
    "" | "-h" | "--help")
        sub_help
        ;;
    *)
        shift
        if test $(type -t sub_${COMMAND_NAME}); then
            sub_${COMMAND_NAME} "$@"
            if [ $? = 127 ]; then
                error "'$COMMAND_NAME' is not a known command or has errors." >&2
            fi
        else
            error "'$COMMAND_NAME' is not a known command." >&2
            sub_help
        fi
        ;;
esac

