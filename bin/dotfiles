#!/usr/bin/env bash
#

# Load libs
source "$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"/lib.sh

# Exit immediately if anything exits with a non-zero status.
set -e

COMMAND_NAME=$1


sub_help () {
    echo "Usage: $(basename $0) <command>"
    echo "Commands:"
    echo "   help                   This help message"
    echo "   bootstrap              Bootstrap the dotfiles"
    echo "   gitconfig              Setup git configuration"
    echo "   sshconfig              Setup ssh config file"
    echo "   install macos          Install reasonable macOS defaults"
    echo "   install macos <app>    Apply prefs for just one app/pane (e.g. finder, dock)"
    echo "   install homebrew       Install homebrew & cask"
    echo "   install homebrew <x>   Install one Brewfile entry + its prefs (e.g. sublime-text)"
    echo "   install ai             Install AI tooling (sbx, Claude desktop) & agent skills"
    echo "   install <x>            Install package x"
}



# Helper functions

link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        action=
        until [ -n "$action" ]
        do
          warn "$dst already exists, what do you want to do? [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
          # Read from the controlling terminal explicitly, not stdin: callers
          # like sub_bootstrap run this inside a `while read < <(find ...)`
          # loop, which binds fd 0 to the find pipe for the whole loop body.
          # A plain `read` here would silently steal bytes off that pipe
          # instead of waiting for a keypress - resolving prompts on stray
          # characters from upcoming filenames and corrupting the next
          # iteration's $src in the process.
          read -n 1 action < /dev/tty
          echo

          case "$action" in
            o )
              overwrite=true;;
            O )
              overwrite_all=true;;
            b )
              backup=true;;
            B )
              backup_all=true;;
            s )
              skip=true;;
            S )
              skip_all=true;;
            * )
              action=;;
          esac
        done

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      ok "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      ok "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      ok "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    ok "linked $1 to $2"
  fi
}

# Sub commands

sub_bootstrap () {
  bot 'Updating repo & submodules...'
  if [ -d "$DOTFILES_DIR/.git" ]; then
    pushd $DOTFILES_DIR >/dev/null
    git pull origin master
    ok "repository updated"
    git submodule update --init --recursive
    ok "submodules initialized & updated"
    popd >/dev/null
  fi

  bot 'Installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  while IFS= read -r -d '' src
  do
    # Everything below the topic dir (the *.symlink file's path relative to
    # the immediate child-of-$DOTFILES_DIR directory it lives in) is mirrored
    # as-is under $HOME, with the .symlink suffix stripped. E.g.
    # zsh/.zshrc.symlink -> ~/.zshrc, and
    # ghostty/.config/ghostty/config.symlink -> ~/.config/ghostty/config.
    # Nothing adds a leading dot implicitly (unlike the old basename-only
    # rule this replaced) - a top-level dotfile source has to spell it out
    # itself, e.g. zsh/.zshrc.symlink, not zsh/zshrc.symlink.
    rel="${src#"$DOTFILES_DIR"/}"
    rel="${rel#*/}"
    dst="$HOME/${rel%.symlink}"
    mkdir -p "$(dirname "$dst")"
    link_file "$src" "$dst"
  done < <(find "$DOTFILES_DIR" -mindepth 2 -not -path "$DOTFILES_DIR/.git/*" -name '*.symlink' -print0)

  ok 'dotfiles installed'
}

sub_gitconfig () {
  if ! [ -f $DOTFILES_DIR/git/.gitconfig.symlink ]
  then
    bot 'Setup gitconfig'

    echo -e ' - What is your global git author name?'
    read -e git_authorname
    echo -e ' - What is your global git author email?'
    read -e git_authoremail
    echo -e ' - What is your global git signing key?'
    read -e git_signingkey

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/AUTHORSIGNINGKEY/$git_signingkey/g" $DOTFILES_DIR/git/gitconfig.symlink.example > $DOTFILES_DIR/git/.gitconfig.symlink

    ok 'gitconfig set up'
  fi
}

sub_sshconfig () {
  if ! [ -f ~/.ssh/config ]
  then
    bot 'SSH config'
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh
    cp $DOTFILES_DIR/ssh/config.example ~/.ssh/config

    echo -e ' What will the key name be? eg "name" will become id.name[.pub]'
    read
    if [[ ! -z $REPLY ]]; then
      # Build the key comment as username@keyname, like ssh-keygen's default
      # username@hostname but using the key name in place of the hostname:
      # this step can run before the machine's real ComputerName is set (see
      # `install macos`), which would otherwise bake a stale/default hostname
      # into the public key comment permanently. $(whoami) is correct at this
      # point regardless of that ordering.
      ssh-keygen -t ed25519 -C "$(whoami)@$REPLY" -f ~/.ssh/id.$REPLY
      echo "IdentityFile ~/.ssh/id.$REPLY" > ~/.ssh/identity
      chmod 600 ~/.ssh/identity
    fi
  fi
}

sub_install () {
    # Not `local topic="$1"; shift`: with no arguments, that `shift` fails and
    # set -e ends the whole script silently.
    local topic="${1:-}"
    if [ -z "$topic" ]; then
        error "Missing topic to install, one of: $(cd "$DOTFILES_DIR" && ls -d */install.sh | sed 's|/install.sh$||' | tr '\n' ' ')"
        return 1
    fi
    shift

    local SCRIPT="${DOTFILES_DIR}/${topic}/install.sh"
    if [ -f "$SCRIPT" ]; then
        source "$SCRIPT" "$@"
    else
        error "Unable to find script to install ${topic}"
        return 1
    fi
}


case $COMMAND_NAME in
    "" | "-h" | "--help")
        sub_help
        ;;
    *)
        shift
        if test $(type -t sub_${COMMAND_NAME}); then
            sub_${COMMAND_NAME} "$@"
            if [ $? = 127 ]; then
                error "'$COMMAND_NAME' is not a known command or has errors." >&2
            fi
        else
            error "'$COMMAND_NAME' is not a known command." >&2
            sub_help
        fi
        ;;
esac

