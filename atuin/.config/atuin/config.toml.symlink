# Atuin configuration - https://docs.atuin.sh/configuration/config/
# Anything not set here uses atuin's defaults.

# Sync is end-to-end encrypted with a key that never leaves the machine
# (~/.local/share/atuin/key, also kept in 1Password). Does nothing until this
# machine is logged in with `atuin register` or `atuin login`.
auto_sync = true

# Installed and upgraded through Homebrew.
update_check = false

# Enter runs the selected command, Tab puts it on the prompt to edit (same as hstr).
enter_accept = true
